# libSQL / Turso — `turso db show <name> --url` and `turso db tokens create <name>`
TURSO_DATABASE_URL=libsql://bufferoverride-<org>.turso.io
TURSO_AUTH_TOKEN=

# Canonical origin, used for URLs, feeds, JSON-LD and OG images
PUBLIC_BASE_URL=http://localhost:3000

# Railway supplies PORT in production; the gateway binds it
PORT=3000

# Volume mount. Railway mounts the volume at /data
MEDIA_ROOT=./.data/media

# Which supervised daemons to run. Comma-separated: web,api,media,worker
# Trim this in development to boot faster.
SERVICES=web,api,media,worker
