# Postgres in production (the client is @profullstack/libsql-pg); a local libSQL
# file for development and the tests. Turso (libsql://) is no longer read: the
# data was copied to Postgres with `npx libsql-pg copy` in 2026-09.
DATABASE_URL=postgres://postgres:password@localhost:5432/bufferoverride
# DATABASE_URL=file:./.data/local.db

# Canonical origin, used for URLs, feeds, JSON-LD and OG images
PUBLIC_BASE_URL=http://localhost:3000

# Railway supplies PORT in production; the gateway binds it
PORT=3000

# Volume mount. Railway mounts the volume at /data
MEDIA_ROOT=./.data/media

# Which supervised daemons to run. Comma-separated: web,api,media,worker
# Trim this in development to boot faster.
SERVICES=web,api,media,worker

# Crawl gateway (@profullstack/x402-gateway): AI training crawlers pay $1/day over
# x402. A SCOPED CoinPay key (payments:create) and the EVM address that receives
# the USDC. Unset = crawlers still get 402, nothing sold.
COINPAY_X402_KEY=
CRAWL_PAY_TO=
