{
  "name": "bufferoverride",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @bufferoverride/web build",
    "start": "node apps/gateway/src/index.js",
    "dev": "node apps/gateway/src/index.js",
    "migrate": "node --env-file-if-exists=.env packages/db/src/migrate.js",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  }
}
